# Keep Sandra's production catalog in the repository so Hostinger deployments
# start with the verified local data. Runtime locks/backups/discovery state stay local.
artifacts/api-server/data/*
!artifacts/api-server/data/sandra-catalog.json
artifacts/api-server/data/sandra-catalog.json.lock
artifacts/api-server/data/sandra-catalog.json.backups/
artifacts/api-server/data/sandra-discovery-state.json
artifacts/api-server/.test/
# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
