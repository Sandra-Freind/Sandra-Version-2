{
  "expo": {
    "name": "Sandra",
    "slug": "sandra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sandra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hollidayfriend.sandra",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sandra benötigt das Mikrofon für den Deutsch-Thai-Live-Dolmetscher.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Sandra benötigt das Mikrofon für den Deutsch-Thai-Live-Dolmetscher."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
